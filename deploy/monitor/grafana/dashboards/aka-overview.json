{
  "title": "aka-mvpset の概要",
  "uid": "aka-overview",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "type": "timeseries",
      "title": "ノードの up",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "up{job=\"node\"}",
          "legendFormat": "{{node}} {{container}}{{process}}{{peer}}{{slot}}{{item}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "動いていないコンテナ（0 が止まっている）",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "min by (node) (aka_container_running)",
          "legendFormat": "{{node}} {{container}}{{process}}{{peer}}{{slot}}{{item}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "dockerd・containerd の RSS",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "aka_process_rss_bytes",
          "legendFormat": "{{node}} {{container}}{{process}}{{peer}}{{slot}}{{item}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "WireGuard のハンドシェイクの経過",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "aka_wg_handshake_age_seconds",
          "legendFormat": "{{node}} {{container}}{{process}}{{peer}}{{slot}}{{item}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "外形監視の成否（1 が成功）",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "aka_probe_success",
          "legendFormat": "{{node}} {{container}}{{process}}{{peer}}{{slot}}{{item}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "バックアップの経過",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "time() - aka_backup_last_success_seconds",
          "legendFormat": "{{node}} {{container}}{{process}}{{peer}}{{slot}}{{item}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "証明書の残り",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "aka_cert_not_after_seconds - time()",
          "legendFormat": "{{node}} {{container}}{{process}}{{peer}}{{slot}}{{item}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CRL の次の更新までの残り",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "aka_crl_next_update_seconds - time()",
          "legendFormat": "{{node}} {{container}}{{process}}{{peer}}{{slot}}{{item}}",
          "refId": "A"
        }
      ]
    }
  ]
}
