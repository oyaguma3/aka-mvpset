# リハーサルのノードの役（Debian 13。systemd はない）。bootstrap.sh が入れるパッケージを先に入れておく（apt を速くするため）。
FROM debian:13.7-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
	sudo wireguard-tools wireguard-go nftables rsync acl unattended-upgrades ca-certificates curl gnupg jq openssl \
	logrotate python3 netcat-openbsd systemd-timesyncd openssh-server iproute2 procps tzdata iputils-ping \
	&& rm -rf /var/lib/apt/lists/*
COPY node-entry.sh svc.py /usr/local/bin/
ENTRYPOINT ["/usr/local/bin/node-entry.sh"]
