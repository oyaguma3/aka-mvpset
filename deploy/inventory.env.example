# 配置の手元の値（docs/deployment.md §1）。写して inventory.env にし、リポジトリの外（作業ディレクトリ）に置く。
# 公開のリポジトリなので、本物のアドレス・ドメイン・鍵はこのファイルに書かない。
# deploy/bin/render が読む。WireGuard の公開鍵は bootstrap.sh の出力を貼る（秘密鍵は各ノードから出さない）。

# ノード（名前は固定。エッジは EDGES に足していく）
EDGES="edge-01 edge-02"

# 公開のアドレス（事業者のコントロールパネルで確かめる）
PUB_data=203.0.113.10
PUB_mgmt=203.0.113.11
PUB_mon=203.0.113.12
PUB_edge_01=203.0.113.21
PUB_edge_02=203.0.113.22

# サービス用の WireGuard（wg-svc、ハブなし。S5-6・D1）
SVC_NET=10.81.0.0/24
SVC_PORT=51820
SVC_data=10.81.0.1
SVC_mgmt=10.81.0.2
SVC_edge_01=10.81.0.11
SVC_edge_02=10.81.0.12

# 運用用の WireGuard（wg-ops、監視ノードがハブで、中継はしない。D1・D2）
OPS_NET=10.82.0.0/24
OPS_PORT=51821
OPS_mon=10.82.0.1
OPS_data=10.82.0.2
OPS_mgmt=10.82.0.3
OPS_edge_01=10.82.0.11
OPS_edge_02=10.82.0.12
OPS_pc=10.82.0.100

# WireGuard の公開鍵（bootstrap.sh・ops-pc の出力）
WGSVC_PUB_data=
WGSVC_PUB_mgmt=
WGSVC_PUB_edge_01=
WGSVC_PUB_edge_02=
WGOPS_PUB_mon=
WGOPS_PUB_data=
WGOPS_PUB_mgmt=
WGOPS_PUB_edge_01=
WGOPS_PUB_edge_02=
WGOPS_PUB_pc=

# 最初の導入の間だけ SSH を受ける送信元（手元の回線の公開のアドレス。空白で区切る。終わったら空にして描き直す。D4）
BOOTSTRAP_SSH_FROM="198.51.100.7"

# SSH の鍵（公開鍵の 1 行）。ADMIN は作業ユーザー aka、PULL は ops-pc の pull（ログとバックアップの取得）
ADMIN_SSH_KEY="ssh-ed25519 AAAA... aka-mvp"
PULL_SSH_KEY="ssh-ed25519 AAAA... ops-pc-pull"

# 手元から ops-pc（監視用の PC の役）へ入る SSH の名前（~/.ssh/config の Host）。ops-pc のコンテナの名前
OPS_PC_HOST=simwifi2
OPS_PC_CONTAINER=ops-pc
# 監視ノードへの入り方を変えるとき（リハーサルなど）。既定は ssh <OPS_PC_HOST> docker exec -i <OPS_PC_CONTAINER> nc %h %p
#OPS_PC_PROXY=
# 作業ユーザーの秘密鍵（手元）
ADMIN_SSH_IDENTITY=~/.ssh/aka_mvp_ed25519

# DNS（検証用のサブドメイン。S5-3）と aka-ossbss の公開のホスト名（blackbox で見る）
DNS_DOMAIN=radsec-dev.example.jp
OSSBSS_URL=https://ossbss-dev.example.jp/
