diff -u -r a/tlscommon.c b/tlscommon.c
--- a/tlscommon.c	2026-08-08 00:33:11.000000000 +0900
+++ b/tlscommon.c	2026-10-20 22:58:08.295387935 +0900
@@ -517,6 +517,16 @@
         X509_STORE_set_flags(x509_s, X509_V_FLAG_CRL_CHECK | X509_V_FLAG_CRL_CHECK_ALL);
     if (conf->vpm)
         X509_STORE_set1_param(x509_s, conf->vpm);
+    if (conf->partialchain) {
+#ifdef X509_V_FLAG_PARTIAL_CHAIN
+        /* treat (non self-signed) CAs in CACertificateFile/Path as trust anchors */
+        X509_STORE_set_flags(x509_s, X509_V_FLAG_PARTIAL_CHAIN);
+#else
+        debug(DBG_ERR, "tlsaddcacrl: PartialChain is not supported by this OpenSSL version");
+        X509_STORE_free(x509_s);
+        return 0;
+#endif
+    }
     SSL_CTX_set_cert_store(ctx, x509_s);
 
     calist = sk_X509_NAME_new_null();
@@ -1153,6 +1163,7 @@
                           "CertificateKeyPassword", CONF_STR, &conf->certkeypwd,
                           "CacheExpiry", CONF_LINT, &conf->cacheexpiry,
                           "CRLCheck", CONF_BLN, &conf->crlcheck,
+                          "PartialChain", CONF_BLN, &conf->partialchain,
                           "PolicyOID", CONF_MSTR, &conf->policyoids,
                           "CipherList", CONF_STR, &conf->cipherlist,
                           "CipherSuites", CONF_STR, &conf->ciphersuites,
